# ==============================================================================
# MAXICONECTA - VARIABLES DE ENTORNO GLOBALES
# ==============================================================================

# Entorno: development | staging | production
ENVIRONMENT=development
DEBUG=True

# ------------------------------------------------------------------------------
# SUPABASE / POSTGRESQL
# ------------------------------------------------------------------------------
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu-anon-key-publica
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-privada
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_JWKS_URL=https://tu-proyecto.supabase.co/auth/v1/.well-known/jwks.json
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/maxiconecta

# ------------------------------------------------------------------------------
# REDIS (Caché de Carrito y Reservas de Stock)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# SEGURIDAD Y JWT (Supabase Auth)
# ------------------------------------------------------------------------------
JWT_SECRET=tu-jwt-secret-de-supabase
JWT_ALGORITHM=HS256
VALES_CODIGO_SECRET=
# Configurar en staging/production; HMAC-SHA256 del mensaje tx|evento|monto con 2 decimales.
PAGOS_WEBHOOK_SECRET=

# Entregas: requests al tópico del ERP; respuestas en una suscripción propia de MaxiConecta.
PUBSUB_TOPIC_ENTREGAS=projects/project-a96e5fe1-5ba6-4698-a85/topics/ucb-sis323-sub-e
PUBSUB_TOPIC_RESPUESTAS_ENTREGAS=projects/project-a96e5fe1-5ba6-4698-a85/topics/ucb-sis323-sub-e
PUBSUB_SUBSCRIPTION_ENTREGAS=
DESPACHOS_WORKER_ENABLED=true
# Solo demostración: publica el cálculo local; no solicita ni crea un despacho.
PUBSUB_COTIZACIONES_SIMULACION_ENABLED=false

# ------------------------------------------------------------------------------
# TOPOLOGÍA DE MICROSERVICIOS INTERNOS (Para el API Gateway)
# ------------------------------------------------------------------------------
GATEWAY_PORT=8000
MS_CATALOGO_URL=http://localhost:8001
MS_POS_URL=http://localhost:8002
MS_CARRITO_URL=http://localhost:8003
MS_CLIENTES_URL=http://localhost:8004
MS_ORDENES_URL=http://localhost:8005
MS_REPORTES_URL=http://localhost:8006

# ------------------------------------------------------------------------------
# CORREO TRANSACCIONAL (KAN-46 / KAN-217)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=usuario_smtp
SMTP_PASSWORD=contrasena_smtp
SMTP_FROM_EMAIL=notificaciones@maxiconecta.bo
SMTP_USE_TLS=true
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# CONTRATOS ERP EXTERNOS (Simulación o Producción RIO)
# ------------------------------------------------------------------------------
ERP_INVENTARIOS_URL=http://localhost:9001
ERP_PAGOS_URL=http://localhost:9002
ERP_CONTABILIDAD_URL=http://localhost:9003
ERP_CRM_URL=http://localhost:9004
ERP_ENTREGAS_URL=http://localhost:9005
ERP_PRODUCCION_URL=http://localhost:9006
ERP_TIMEOUT_SECONDS=5.0

# ------------------------------------------------------------------------------
# FRONTEND
# ------------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
VITE_API_GATEWAY_URL=http://localhost:8000
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica

# ------------------------------------------------------------------------------
# CAJA Y PAGOS (KAN-342 / KAN-54)
# ------------------------------------------------------------------------------
# Retiro de efectivo (Bs.) a partir del cual se exige confirmación de un supervisor
CAJA_LIMITE_SEGURIDAD_RETIRO=2000
AUDIT_SPOOL_PATH=.audit/events.sqlite3
# Secreto compartido para firmar (HMAC-SHA256) los webhooks de la pasarela de pagos simulada
PAGOS_WEBHOOK_SECRET=cambia-este-secreto-en-produccion

# CRM: mismo tópico que despachos por defecto. Suscripción propia para respuestas.
# PUBSUB_TOPIC_CRM=projects/PROYECTO/topics/TOPICO_COMPARTIDO
PUBSUB_SUBSCRIPTION_CRM=
CRM_WORKER_ENABLED=true
